CRM_IMAGE=your-dockerhub-user/crm-frappe:latest
SITE_NAME=frappe.f-caps.net
ADMIN_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
HTTP_PORT=8000
SOCKETIO_PORT=9000
GUNICORN_WORKERS=1
# Auto-seed the curated CRM demo dataset the first time the dev site is created.
# Set to 0 to bring the container up with an empty site.
CRM_SEED_DEMO=1
CRM_AGENTS_DEMO_FULL_ACCESS=0
# Server-only crm-agents BFF settings. Required for Copilot/NBA delegation.
# Fill these from the local crm-agents runtime; never commit actual secrets.
CRM_AGENTS_URL=http://host.docker.internal:7999
CRM_AGENTS_API_KEY=
CRM_AGENTS_DELEGATION_KEYS_JSON=
CRM_AGENTS_DELEGATION_ACTIVE_KID=v1
CRM_AGENTS_DELEGATION_ISSUER=http://crm.localhost:8001
# API credentials for the dedicated ai-service@crm-agents.local Frappe user.
# They must match FRAPPE_API_KEY/FRAPPE_API_SECRET in crm-agents/.env.
CRM_AGENTS_SERVICE_API_KEY=
CRM_AGENTS_SERVICE_API_SECRET=
CRM_GOOGLE_OAUTH_CLIENT_ID=
CRM_GOOGLE_OAUTH_CLIENT_SECRET=
CRM_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/method/crm.api.google_auth.callback
CRM_GOOGLE_OAUTH_DEFAULT_ROLE=Sale
CRM_GOOGLE_OAUTH_ALLOWED_DOMAINS=
# Origin of the external admissions dashboard. Used both as the post-login
# redirect allowlist and to grant it CORS access on install/migrate.
# Local dev: http://localhost:3000 (Next.js). Production: https://faip.pro
CRM_GOOGLE_OAUTH_DASHBOARD_URL=http://localhost:3000
